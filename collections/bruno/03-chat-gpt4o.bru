meta {
  name: Chat - OpenAI GPT-4o
  type: http
  seq: 3
}

post {
  url: {{base_url}}/v1/chat/completions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "system",
        "content": "You are a helpful coding assistant."
      },
      {
        "role": "user",
        "content": "Explain what LiteLLM proxy does in 2 concise sentences."
      }
    ],
    "temperature": 0.7
  }
}
