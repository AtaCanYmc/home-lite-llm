meta {
  name: Chat - DeepSeek Chat
  type: http
  seq: 6
}

post {
  url: {{base_url}}/v1/chat/completions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "deepseek-chat",
    "messages": [
      {
        "role": "user",
        "content": "Hello DeepSeek! What makes your model efficient?"
      }
    ]
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Chat completion returns message content", function () {
    const body = res.getBody();
    expect(body).to.have.property("choices");
    expect(body.choices).to.be.an("array").that.is.not.empty;
    expect(body.choices[0].message.content).to.be.a("string").that.is.not.empty;
  });
}
