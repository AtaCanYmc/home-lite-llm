meta {
  name: Chat - xAI Grok 2
  type: http
  seq: 7
}

post {
  url: {{base_url}}/v1/chat/completions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "grok-2",
    "messages": [
      {
        "role": "system",
        "content": "You are Grok, a conversational AI developed by xAI."
      },
      {
        "role": "user",
        "content": "Hello Grok! Tell me a fun scientific curiosity."
      }
    ],
    "temperature": 0.7
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Chat completion returns message content", function () {
    const body = res.getBody();
    expect(body).to.have.property("choices");
    expect(body.choices).to.be.an("array").that.is.not.empty;
    expect(body.choices[0].message.content).to.be.a("string").that.is.not.empty;
  });
}
