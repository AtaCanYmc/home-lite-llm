meta {
  name: Chat - Local Ollama (Llama 3.3 / DeepSeek-R1)
  type: http
  seq: 9
}

post {
  url: {{base_url}}/v1/chat/completions
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "ollama-llama3.3",
    "messages": [
      {
        "role": "system",
        "content": "You are a local LLM running on host machine via Ollama."
      },
      {
        "role": "user",
        "content": "Hello Ollama! What are your current system specs?"
      }
    ],
    "temperature": 0.7
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Chat completion returns message content", function () {
    const body = res.getBody();
    expect(body).to.have.property("choices");
    expect(body.choices).to.be.an("array").that.is.not.empty;
    expect(body.choices[0].message.content).to.be.a("string").that.is.not.empty;
  });
}
