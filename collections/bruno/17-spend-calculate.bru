meta {
  name: Calculate Spend
  type: http
  seq: 17
}

post {
  url: {{base_url}}/spend/calculate
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "model": "gpt-4o",
    "messages": [
      {
        "role": "user",
        "content": "Hello, how are you?"
      }
    ]
  }
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("Spend calculation returns cost", function () {
    const data = res.getBody();
    expect(data).to.be.an("object");
    expect(data).to.have.property("cost");
    expect(data.cost).to.be.a("number");
  });
}
