  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{master_key}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "01 - Health & Observability",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health",
              "host": ["{{base_url}}"],
              "path": ["health"]
            },
            "description": "Checks if the LiteLLM proxy instance and database connection are healthy."
          },
          "response": []
        },
        {
          "name": "List Active Models",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/v1/models",
              "host": ["{{base_url}}"],
              "path": ["v1", "models"]
            },
            "description": "Returns all configured and available LLM models in OpenAI format."
