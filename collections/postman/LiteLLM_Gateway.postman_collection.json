    {
      "name": "02 - Chat Completions",
      "item": [
        {
          "name": "OpenAI - GPT-4o",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are a helpful and precise coding assistant.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Explain how LiteLLM load balances across multiple providers in 2 concise sentences.\"\n    }\n  ],\n  \"temperature\": 0.7\n}"
            },
            "url": {
              "raw": "{{base_url}}/v1/chat/completions",
              "host": ["{{base_url}}"],
              "path": ["v1", "chat", "completions"]
            },
            "description": "Standard non-streaming chat completion request using GPT-4o."
