{
  "info": {
    "_postman_id": "a91e5927-1428-4dc8-a89e-lite-llm-gateway",
    "name": "LiteLLM Proxy Gateway",
    "description": "Comprehensive API collection for LiteLLM Gateway, covering OpenAI-compatible endpoints, multi-provider chat completions, streaming, healthchecks, and virtual key management.",
