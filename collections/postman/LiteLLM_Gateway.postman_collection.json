    {
      "name": "03 - Admin & Key Management",
      "item": [
        {
          "name": "Generate Virtual API Key",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"max_budget\": 10.0,\n  \"duration\": \"30d\",\n  \"models\": [\"gpt-4o-mini\", \"claude-3-5-haiku\", \"gemini-2.0-flash\"],\n  \"metadata\": {\n    \"user\": \"frontend-developer-1\",\n    \"project\": \"mobile-app-v2\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/key/generate",
              "host": ["{{base_url}}"],
              "path": ["key", "generate"]
            },
            "description": "Generates a budget-constrained virtual key for a specific user, team, or project."
          },
          "response": []
        },
        {
          "name": "Get Key Information & Spend",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/key/info?key={{virtual_key}}",
              "host": ["{{base_url}}"],
              "path": ["key", "info"],
              "query": [
                {
                  "key": "key",
                  "value": "{{virtual_key}}",
                  "description": "The virtual API key to inspect"
                }
              ]
            },
            "description": "Retrieves real-time spend, remaining budget, and limits for a virtual API key."
          },
          "response": []
        },
        {
          "name": "Calculate Spend / Pricing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"model\": \"gpt-4o\",\n  \"messages\": [\n    {\n      \"role\": \"user\",\n      \"content\": \"Hello world!\"\n    }\n  ],\n  \"response\": {\n    \"choices\": [\n      {\n        \"message\": {\n          \"role\": \"assistant\",\n          \"content\": \"Hello! How can I help you today?\"\n        }\n      }\n    ],\n    \"usage\": {\n      \"prompt_tokens\": 10,\n      \"completion_tokens\": 9,\n      \"total_tokens\": 19\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/spend/calculate",
              "host": ["{{base_url}}"],
              "path": ["spend", "calculate"]
            },
            "description": "Calculates the USD cost for a given model inference usage."
          },
          "response": []
        }
      ]
    }
