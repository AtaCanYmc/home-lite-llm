#!/usr/bin/env bash
set -euo pipefail

SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
ROOT_DIR="$(cd -P "$(dirname "$SOURCE")/.." && pwd)"
cd "$ROOT_DIR"

if [ -n "${NO_COLOR:-}" ] || [ ! -t 1 ]; then
  BOLD="" DIM="" GREEN="" YELLOW="" RED="" CYAN="" RESET=""
else
  BOLD='\033[1m' DIM='\033[2m' GREEN='\033[32m' YELLOW='\033[33m' RED='\033[31m' CYAN='\033[36m' RESET='\033[0m'
fi

get_version() {
  if [ -f .release-please-manifest.json ]; then
    sed -n 's/.*"\.": "\([^"]*\)".*/\1/p' .release-please-manifest.json | head -n1
  else
    echo "1.3.1" # x-release-please-version
  fi
}

usage() {
  printf "${BOLD}${CYAN}hlm${RESET} — Home LiteLLM CLI (v%s)\n\n" "$(get_version)"
  cat <<'EOF'
Usage: hlm <command> [args]

Lifecycle:
  up          Start all services in background
  down        Stop all services
  restart     Restart all services
  status      Show container status
  logs [svc]  Follow logs (all or specific service)

Diagnostics:
  health      Check LiteLLM readiness endpoint
  validate    Validate config.yaml and .env
  doctor      Check local dependencies and config files
  models      List active models from LiteLLM
  test-api    Run Bruno API endpoint tests

Tools:
  dsh         Launch DeepSeek Harness (dsh) with LiteLLM patch
  version     Print hlm version

Database:
  backup      Create PostgreSQL backup
  restore <f> Restore PostgreSQL backup from file
  help        Show this help
EOF
}

run_doctor() {
  local ok=0
  for bin in docker python3 curl; do
    if command -v "$bin" >/dev/null 2>&1; then
      printf "  ${GREEN}✔${RESET} %-14s %s\n" "$bin" "$(command -v "$bin")"
    else
      printf "  ${RED}✖${RESET} %-14s missing\n" "$bin"
      ok=1
    fi
  done
  for cfg in config.yaml .env; do
    if [ -f "$cfg" ]; then
      printf "  ${GREEN}✔${RESET} %-14s present\n" "$cfg"
    else
      printf "  ${YELLOW}!${RESET} %-14s missing (copy from .env.example if needed)\n" "$cfg"
    fi
  done
  return "$ok"
}

cmd="${1:-help}"
shift || true

case "$cmd" in
  up|start)    docker compose up -d "$@" ;;
  down|stop)   docker compose down "$@" ;;
  restart)     docker compose restart "$@" ;;
  status|ps)   docker compose ps "$@" ;;
  logs)        docker compose logs -f "$@" ;;
  health)      curl -sf http://127.0.0.1:4000/health/readiness && echo "" ;;
  validate)    python3 scripts/validate_config.py "$@" ;;
  doctor)      run_doctor ;;
  models)
    KEY=""
    if [ -f .env ]; then
      KEY="$(grep -E '^MASTER_KEY=' .env | cut -d '=' -f2- | tr -d "\"'")"
    fi
    if [ -n "$KEY" ]; then
      curl -sf -H "Authorization: Bearer $KEY" http://127.0.0.1:4000/v1/models | python3 -m json.tool
    else
      curl -sf http://127.0.0.1:4000/v1/models | python3 -m json.tool
    fi
    ;;
  test-api)
    if command -v bru >/dev/null 2>&1; then
      (cd collections/bruno && bru run --env Local "$@")
    else
      (cd collections/bruno && npx @usebruno/cli run --env Local "$@")
    fi
    ;;
  dsh)
    PATCH_FILE="$ROOT_DIR/docs/homelitellm.patch.yml"
    [ -f "$PATCH_FILE" ] || PATCH_FILE="$ROOT_DIR/share/home-lite-llm/homelitellm.patch.yml"
    npx @deepseek-ai/dsh web --patch "$PATCH_FILE" "$@"
    ;;
  backup)      ./scripts/backup_db.sh "$@" ;;
  restore)
    if [ -z "${1:-}" ]; then
      echo "Usage: hlm restore <backup-file>" >&2
      exit 1
    fi
    ./scripts/restore_db.sh "$1"
    ;;
  version|-v|--version) echo "hlm $(get_version)" ;;
  help|-h|--help) usage ;;
  *)
    echo "Unknown command: $cmd" >&2
    usage
    exit 1
    ;;
esac
