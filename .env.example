# LiteLLM Proxy Master Key (For API Requests and Admin Panel Access)
MASTER_KEY=sk-your-secure-and-long-master-key-here

# LiteLLM Admin UI Login Credentials (Optional Custom Username & Password)
UI_USERNAME=litellm_admin
UI_PASSWORD=sk-your-secure-and-long-master-key-here

# Grafana Dashboard Login Credentials
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your_grafana_password_here

# -----------------------------------------------------------------
# Database Configuration (Local Postgres or Supabase / Remote Postgres)
# -----------------------------------------------------------------
# Option 1: Local PostgreSQL User, DB Name & Password
POSTGRES_USER=postgres
POSTGRES_DB=litellm
POSTGRES_PASSWORD=your_postgres_password_here

# Option 2: External PostgreSQL / Supabase Database Connection String
# Uncomment DATABASE_URL to use Supabase (or any external Postgres DB) instead of local container:
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# -----------------------------------------------------------------
# Model Provider API Keys (Fill according to models you intend to use)
# -----------------------------------------------------------------

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# xAI (Grok)
XAI_API_KEY=your_xai_api_key_here

# Mistral AI

MISTRAL_API_KEY=your_mistral_api_key_here

# Groq
GROQ_API_KEY=your_groq_api_key_here

# Cohere
COHERE_API_KEY=your_cohere_api_key_here

# Together AI
TOGETHERAI_API_KEY=your_togetherai_api_key_here

# Fireworks AI
FIREWORKS_API_KEY=your_fireworks_api_key_here

# OpenRouter
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Perplexity AI
PERPLEXITYAI_API_KEY=your_perplexity_api_key_here

# Azure OpenAI
AZURE_API_KEY=your_azure_api_key_here
AZURE_API_BASE=https://your-resource-name.openai.azure.com/
AZURE_API_VERSION=2024-02-15-preview

# AWS Bedrock
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION_NAME=us-east-1

# Local LLM Servers (Running on Host Machine)
OLLAMA_API_BASE=http://host.docker.internal:11434
LMSTUDIO_API_BASE=http://host.docker.internal:1234/v1
VLLM_API_BASE=http://host.docker.internal:8000/v1
LOCALAI_API_BASE=http://host.docker.internal:8080/v1


# -----------------------------------------------------------------
# Remote Access / Tunnel Configuration (Optional)
# See tunnels/README.md for full setup instructions.
# -----------------------------------------------------------------

# Cloudflare Tunnel — Named (permanent) tunnel token
# Get from: https://one.cloudflare.com → Networks → Tunnels
# Leave empty to use free temporary TryCloudflare URL (no account needed)
# TUNNEL_TOKEN=eyJhIjoiMT...

# ngrok — AuthToken for registered account features
# Get from: https://dashboard.ngrok.com/get-started/your-authtoken
# Leave empty for anonymous (free, temporary URL)
# NGROK_AUTHTOKEN=2abc123def456...

# Tailscale — Auth Key for headless/automated join
# Get from: https://login.tailscale.com/admin/settings/keys
# Leave empty to use interactive browser login
# TS_AUTHKEY=tskey-auth-kXXXXXXXXXX-XXXXXXXXXXXXXXXXXX

# Duck DNS — Dynamic DNS for Port Forwarding method
# Sign up free at: https://www.duckdns.org
# DUCKDNS_TOKEN=your-duckdns-token-here
# DUCKDNS_DOMAIN=your-chosen-subdomain
